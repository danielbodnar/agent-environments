# systemd-nspawn settings for a machine imported by import.sh. Installed
# to /etc/systemd/nspawn/<name>.nspawn.
#
# Not booted: the machine runs a login shell as `agent`, the same way the
# image runs under Docker. The container= variable nspawn sets is how
# setup.sh and agent-env-doctor recognize the surface.

[Exec]
Boot=no
User=agent
WorkingDirectory=/home/agent
Parameters=bash -l
PrivateUsers=pick

[Files]
PrivateUsersOwnership=auto

[Network]
# Share the host network. Use VirtualEthernet=yes plus networkd for isolation.
VirtualEthernet=no
