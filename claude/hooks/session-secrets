#!/bin/sh
# session-secrets: Claude Code SessionStart hook.
#
# Writes exports into $CLAUDE_ENV_FILE so every Bash tool call in the
# session sees them:
#   - PATH with mise shims and ~/.local/bin, always
#   - AGENT_ENV_HOME, so bin/with-secrets is easy to find
#   - 1Password secrets, only when AGENT_ENV_EXPORT_SECRETS=1
#
# Exporting secrets puts their values in a file on the session's disk and
# in front of the model. The default is off: commands that need a secret
# run through bin/with-secrets instead and the values stay inside that
# process.
#
# Always exits 0. A broken secret source must not stop a session.

AGENT_ENV_HOME=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)

[ -n "${CLAUDE_ENV_FILE:-}" ] || exit 0

shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
{
	printf 'export AGENT_ENV_HOME=%s\n' "'$AGENT_ENV_HOME'"
	# shellcheck disable=SC2016 # $PATH expands when the env file is sourced
	printf 'export PATH="%s:%s:%s:$PATH"\n' "$AGENT_ENV_HOME/bin" "$HOME/.local/bin" "$shims"
} >>"$CLAUDE_ENV_FILE"

[ "${AGENT_ENV_EXPORT_SECRETS:-0}" = 1 ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# Run `jq -n env` with and without the secrets, then export only the
# variables op added or changed. --no-masking because op run otherwise
# redacts secret values in the child's output.
before=$(jq -n env)
after=$("$AGENT_ENV_HOME/bin/with-secrets" --no-masking -- jq -n env 2>/dev/null) || {
	echo "session-secrets: couldn't load secrets, continuing without them" >&2
	exit 0
}
jq -rn --argjson a "$before" --argjson b "$after" '
	$b | to_entries[]
	| select($a[.key] != .value)
	| select(.key | test("^(OP_|_$|SHLVL$|PWD$)") | not)
	| "export \(.key)=\(.value | @sh)"' >>"$CLAUDE_ENV_FILE"
exit 0
