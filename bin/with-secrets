#!/bin/sh
# with-secrets: run a command with 1Password secrets in its environment.
#
# Usage:
#   with-secrets [--env-file FILE]... [--] COMMAND [ARG...]
#   with-secrets --no-masking ... print secret values unredacted (hooks only)
#   with-secrets --check        report which auth and sources are configured
#
# Auth, from the environment (the first that's set wins):
#   OP_SERVICE_ACCOUNT_TOKEN              service account (default)
#   OP_CONNECT_HOST + OP_CONNECT_TOKEN    1Password Connect server
#
# Sources:
#   OP_ENVIRONMENT_ID        a 1Password Environment. Service accounts only:
#                            Connect can't read Environments.
#   --env-file FILE          an env file of op:// references, such as
#                            env/.env.tpl. References may use variables,
#                            e.g. op://${OP_VAULT}/github/token.
#   AGENT_ENV_SECRETS_FILE   default --env-file when none is given.
#
# With no auth configured, the command runs without secrets and a
# warning goes to stderr, so the same invocation works on every surface.
set -eu

warn() { printf 'with-secrets: %s\n' "$*" >&2; }

env_files=
check=0
no_masking=0
while [ $# -gt 0 ]; do
	case $1 in
	--env-file)
		env_files="$env_files ${2:?--env-file needs a path}"
		shift
		;;
	--env-file=*) env_files="$env_files ${1#*=}" ;;
	--check) check=1 ;;
	--no-masking) no_masking=1 ;;
	-h | --help)
		sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	--)
		shift
		break
		;;
	*) break ;;
	esac
	shift
done
[ -z "$env_files" ] && [ -n "${AGENT_ENV_SECRETS_FILE:-}" ] && env_files=$AGENT_ENV_SECRETS_FILE

if [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
	auth=service-account
	# op prefers Connect when both are set. Drop Connect so the service
	# account, which can read Environments, is the one used.
	unset OP_CONNECT_HOST OP_CONNECT_TOKEN
elif [ -n "${OP_CONNECT_HOST:-}" ] && [ -n "${OP_CONNECT_TOKEN:-}" ]; then
	auth=connect
else
	auth=none
fi

args=
if [ -n "${OP_ENVIRONMENT_ID:-}" ]; then
	if [ "$auth" = connect ]; then
		warn "OP_ENVIRONMENT_ID ignored: Connect can't read 1Password Environments"
	else
		args="--environment $OP_ENVIRONMENT_ID"
	fi
fi
for f in $env_files; do
	[ -r "$f" ] || {
		warn "env file not readable: $f"
		exit 2
	}
	args="$args --env-file $f"
done

if [ "$check" = 1 ]; then
	printf 'auth=%s\nsources=%s\n' "$auth" "${args:-none}"
	[ "$auth" = none ] || op whoami >/dev/null 2>&1 || {
		warn "op can't authenticate with $auth"
		exit 1
	}
	exit 0
fi

[ $# -gt 0 ] || {
	warn "no command given"
	exit 2
}

if [ "$auth" = none ] || [ -z "$args" ]; then
	[ "$auth" = none ] && warn "no 1Password auth set, running without secrets"
	[ "$auth" != none ] && [ -z "$args" ] && warn "no OP_ENVIRONMENT_ID or env file, running without secrets"
	exec "$@"
fi

command -v op >/dev/null 2>&1 || {
	warn "op not installed (bootstrap/setup.sh --only op)"
	exit 127
}

[ "$no_masking" = 1 ] && args="$args --no-masking"
# shellcheck disable=SC2086 # args holds flag/value pairs without spaces
exec op run $args -- "$@"
