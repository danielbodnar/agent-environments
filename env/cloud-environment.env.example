# Environment variables for a Claude Code cloud environment.
# Paste into: claude.ai/code > environment settings > Environment variables.
#
# Anyone who can use the environment can read these values. Use a
# service account scoped to the vaults an agent needs, with read-only
# access to the 1Password Environment.

# 1Password service account token (ops_...). Required for secrets.
OP_SERVICE_ACCOUNT_TOKEN=

# 1Password Environment ID to load with `op run --environment`. Optional.
OP_ENVIRONMENT_ID=

# Vault name used by op:// references in env/.env.tpl. Optional.
OP_VAULT=

# Default env file for with-secrets. Optional.
AGENT_ENV_SECRETS_FILE=/opt/agent-environments/env/.env.tpl

# 1 exports resolved secrets into every Bash call through the
# SessionStart hook. Leave 0 to keep secrets inside with-secrets calls.
AGENT_ENV_EXPORT_SECRETS=0

# Alternative to the service account: a 1Password Connect server.
# Connect can't read 1Password Environments.
# OP_CONNECT_HOST=https://connect.example.com
# OP_CONNECT_TOKEN=
